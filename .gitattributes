# Force LF for all text files — Windows CRLF breaks shebangs and shell parsing.
* text=auto eol=lf

# Explicitly mark scripts as text with LF.
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files stay untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
