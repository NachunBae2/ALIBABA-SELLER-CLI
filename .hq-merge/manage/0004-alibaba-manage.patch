+# ---- 화면 토큰(보낼 때만 읽어 붙인다) -------------------------------------------------------------
+PRODUCT_CONFIG = PRODUCT + '/product/asyQueryParameter.do'      # 상품 관리 화면 초기값(csrfToken.token)
+RFQ_PAGE = SOURCING + '/rfq/rfq_search_list.htm'                # 내 검색 화면(_csrf_token_·my-search-identity-code)
