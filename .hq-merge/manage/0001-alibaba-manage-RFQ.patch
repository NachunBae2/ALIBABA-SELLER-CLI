+    if isinstance(data, int):
+        return data
+    if isinstance(data, str) and data.isdigit():
+        return int(data)
+    found = []
+
+    def walk(node):
+        if isinstance(node, dict):
+            ctype = node.get('type') if node.get('type') is not None else node.get('campaignType')
