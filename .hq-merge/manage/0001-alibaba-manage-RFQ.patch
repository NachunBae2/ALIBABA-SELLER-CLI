+                         reads=[request('GET', SOURCING + '/rfq/ajax/my_search_list_ajax.do', {},
+                                        label='저장 검색 목록')],
+                         before={}, after={'keyword': keyword}, effect='저장 검색 생성',
+                         warnings=['캡처에서 identityCode·callback 값이 가려져 있다 — 서버가 거부하면 종료 1.'],
