+        elif isinstance(node, list):
+            for inner in node:
+                walk(inner)
+
+    walk(data)
+    found = list(dict.fromkeys(found))
+    if len(found) != 1:
+        raise Usage('쇼케이스 캠페인 id 를 하나로 정하지 못함(%d개) — --campaign 으로 지정' % len(found))
