+def grade_line(plan):
+    grade = plan['grade']
+    if plan.get('grade_note'):
+        return '등급: %s — %s' % (grade, plan['grade_note'])
+    if grade == REVERSIBLE:
+        return '등급: %s — restore <백업> 으로 원값을 되돌린다' % grade
+    if grade == COST:
+        return '등급: %s — %s' % (grade, plan.get('effect') or '매출·외부에 영향')
+    return '등급: %s — %s' % (grade, plan.get('effect') or '단방향 변경')
