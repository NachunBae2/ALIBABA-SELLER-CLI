+def readback_templates(session, plan):
+    templates = read_templates(session)
+    view = [{'ftId': t['ftId'], 'title': t['title'], 'isDefault': t.get('isDefault')} for t in templates]
+    diff = {}
+    if 'title' in plan['after']:
