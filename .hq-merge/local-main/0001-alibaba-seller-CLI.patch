+# -- output ---------------------------------------------------------------------------------------
+def columns(rows):
+    cols = []
+    for r in rows:
+        for c in r:
+            if c not in cols:
+                cols.append(c)
+    return cols
+
+
+def to_csv(rows):
+    buf = io.StringIO()
+    w = csv.DictWriter(buf, fieldnames=columns(rows))
+    w.writeheader()
+    w.writerows(rows)
+    return buf.getvalue()
+
+
+def to_table(name, rows, limit=30):
+    if not rows:
+        return "== %s (0행)\n" % name
+    cols = columns(rows)
+    shown = rows[:limit]
+    cell = lambda v: "" if v is None else str(v)[:60]
+    width = {c: max(len(c), *(len(cell(r.get(c))) for r in shown)) for c in cols}
+    lines = ["== %s (%d행%s)" % (name, len(rows), ", 앞 %d행" % limit if len(rows) > limit else ""),
+             "  ".join(c.ljust(width[c]) for c in cols)]
+    lines += ["  ".join(cell(r.get(c)).ljust(width[c]) for c in cols) for r in shown]
+    return "\n".join(lines) + "\n"
+
+
+def emit(tables, a):
+    if a.out:
+        os.makedirs(a.out, exist_ok=True)
+        for name, rows in tables.items():
+            path = os.path.join(a.out, name[1:] if name.startswith("_") else name + ".csv")
+            with open(path, "w", newline="") as fh:
+                fh.write(rows if isinstance(rows, str) else to_csv(rows) if rows else "")
+    data = {k: v for k, v in tables.items() if not k.startswith("_")}
+    if a.format == "json":
+        print(json.dumps(data, ensure_ascii=False, indent=1, default=str))
+    elif a.format == "csv":
+        for name, rows in data.items():
+            if len(data) > 1:
+                print("# " + name)
+            sys.stdout.write(to_csv(rows) if rows else "")
+    else:
+        for name, rows in data.items():
+            sys.stdout.write(to_table(name, rows, a.limit or 30))
+        for name, text in tables.items():
+            if name.startswith("_"):
+                sys.stdout.write("\n" + text)
+        if a.out:
+            print("written: " + a.out)
+
+
+def main(argv=None):
+    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("command", choices=sorted(COMMANDS))
+    p.add_argument("--from", dest="dirs", action="append", required=True, help="dump folder (repeat for date windows)")
+    p.add_argument("--start")
+    p.add_argument("--end")
+    p.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    p.add_argument("--out")
+    p.add_argument("--limit", type=int)
+    p.add_argument("--unread", action="store_true")
+    p.add_argument("--type", choices=("product", "company", "tm"))
+    p.add_argument("--country")
+    p.add_argument("--status")
+    a = p.parse_args(argv)
+    for d in a.dirs:
+        if not os.path.isdir(os.path.join(d, "raw")):
+            raise SystemExit("not a dump folder (no raw/): " + d)
+    dump = Dump(a.dirs, a.start, a.end)
+    emit(COMMANDS[a.command](dump, a), a)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/engine/seller_central_raw.py b/engine/seller_central_raw.py
new file mode 100755
index 0000000..ad531aa
--- /dev/null
+++ b/engine/seller_central_raw.py
@@ -0,0 +1,357 @@
+#!/usr/bin/env python3
+"""Dump seller-center (Alibaba.com Seller Central) data as raw JSON through the Aside browser.
+
+For every page in pages.json it records each XHR/fetch request the page makes and the raw
+response (capture.js), replays list endpoints page by page, and replays the ads report
+tables over --start/--end. Read-only: nothing that looks like a write endpoint is replayed.
+
+Output (<out>/):
+  raw/<page>.jsonl        one line per request: method, url, body, status, json|text, replay
+  tables/<page>/*.csv     every array of objects found in the responses, flattened
+  manifest.json           per page: status, record count, endpoints, notes
+
+Accounts come from a JSON file outside any repo (default ~/.aliops-ops/seller-report/accounts.json):
+  {"<name>": {"loginId": "<seller login id in the cookie>", "outDir": "...",
+              "keychainService": "...", "keychainAccount": "<login email>"}}
+"""
+import argparse
+import csv
+import datetime as dt
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from urllib.parse import parse_qs
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_CONFIG = os.path.expanduser("~/.aliops-ops/seller-report/accounts.json")
+# Any query/form key with csrf/xsrf/token in its name (ctoken, _tb_token_, _csrf_token_, p_csrf, access_token, ...).
+SECRET_RES = [re.compile(p, re.I) for p in (r"[\w-]*(?:csrf|xsrf|token)[\w-]*=[A-Za-z0-9]", r"_m_h5_tk(?:_enc)?=[A-Za-z0-9]",
+                                               r"\"[\w-]*(?:csrf|xsrf)[\w-]*\\?\"\s*:\s*\\?\"[A-Za-z0-9]")]
+REDACT = re.compile(r"((?:[\w-]*(?:csrf|xsrf|token)[\w-]*|_m_h5_tk(?:_enc)?)=)[^&\"'\s;\\]+", re.I)
+REDACT_JSON = re.compile(r"(\\?\"[\w-]*(?:csrf|xsrf)[\w-]*\\?\"\s*:\s*\\?\")[^\"\\]+", re.I)
+EXIT_SESSION, EXIT_ACCOUNT, EXIT_SECRET = 2, 3, 4
+
+
+def parse_args(argv):
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--account", help="account name in the config file")
+    p.add_argument("--start", help="YYYY-MM-DD for the ads report range replay (default: end - 29 days)")
+    p.add_argument("--end", help="YYYY-MM-DD (default: yesterday)")
+    p.add_argument("--pages", default="all", help="comma-separated page keys from pages.json, or 'all'")
+    p.add_argument("--list-pages", action="store_true", help="print the page keys and exit")
+    p.add_argument("--max-pages", type=int, default=30, help="max list pages replayed per endpoint")
+    p.add_argument("--resume", action="store_true", help="retain existing records and continue unfinished ad range tables")
+    p.add_argument("--config", default=DEFAULT_CONFIG)
+    p.add_argument("--out", help="output directory (default: <outDir>/sellercentral-raw-<end>)")
+    p.add_argument("--login", action="store_true", help="sign Aside in with the keychain password, then exit")
+    a = p.parse_args(argv)
+    end = dt.date.fromisoformat(a.end) if a.end else dt.date.today() - dt.timedelta(days=1)
+    start = dt.date.fromisoformat(a.start) if a.start else end - dt.timedelta(days=29)
+    if start > end:
+        p.error("--start is after --end")
+    a.start_d, a.end_d = start, end
+    return a
+
+
+def load_pages():
+    with open(os.path.join(HERE, "pages.json")) as fh:
+        return json.load(fh)["pages"]
+
+
+def load_account(path, name):
+    with open(path) as fh:
+        accounts = json.load(fh)
+    if name not in accounts:
+        raise SystemExit("account %r not in %s (have: %s)" % (name, path, ", ".join(sorted(accounts))))
+    acc = dict(accounts[name])
+    if not isinstance(acc.get("loginId"), str) or not acc["loginId"].strip():
+        raise SystemExit("nonempty loginId is required")
+    acc.setdefault("asideAccount", "u0")
+    if not re.fullmatch(r"u\d+", acc["asideAccount"]):
+        raise SystemExit("invalid asideAccount")
+    return acc
+
+
+def range_resume(records):
+    state = {}
+    for record in records:
+        replay = record.get("replay") or {}
+        if replay.get("kind") != "range":
+            continue
+        data = json.loads(parse_qs(record.get("body") or "").get("data", ["{}"])[0])
+        result = ((record.get("json") or {}).get("data") or {}).get("queryResult")
+        if not isinstance(result, dict) or not isinstance(result.get("detailList"), list):
+            continue
+        signature = data.get("tableName", "") + json.dumps(data.get("filters") or [], separators=(",", ":"), ensure_ascii=False)
+        page = int(replay.get("page") or 1)
+        size = int((data.get("page") or {}).get("size") or len(result["detailList"]) or 1)
+        covered = (page - 1) * size + len(result["detailList"])
+        total = result.get("totalRows")
+        if not result["detailList"] and isinstance(total, (int, float)) and covered < total:
+            continue
+        entry = state.setdefault(signature, {"nextPage": 1, "covered": 0, "complete": False})
+        entry["nextPage"] = max(entry["nextPage"], page + 1)
+        entry["covered"] = max(entry["covered"], covered)
+        entry["complete"] = entry["complete"] or isinstance(total, (int, float)) and covered >= total
+    return state
+
+
+def run_capture(pg, acc, a, previous):
+    work_root = os.path.expanduser("~/.aside/u/%s" % acc["asideAccount"][1:])
+    os.makedirs(work_root, exist_ok=True)
+    work = tempfile.mkdtemp(prefix="scraw-", dir=work_root)
+    try:
+        out_file = os.path.join(work, "out.json")
+        extra = []
+        for x in pg.get("extra") or []:
+            if x.get("perMonth"):
+                # one query per month in --start..--end. Data advisor picks the period with
+                # selected=N months back from the latest complete month; statDate is ignored.
+                # The count starts at selectedBase: 1 for getProdcutSummary (checked against the
+                # statDate it returns), 0 for getVipEffectiveProductsAndStats (checked by product
+                # totals: 2026-07 = 307 and 2026-08 = 17 in both).
+                latest = dt.date.today().replace(day=1) - dt.timedelta(days=1)
+                m = a.start_d.replace(day=1)
+                while m <= a.end_d.replace(day=1):
+                    base = int(x.get("selectedBase", 0))
+                    back = (latest.year * 12 + latest.month) - (m.year * 12 + m.month) + base
+                    if back >= base:
+                        extra.append({**x, "tag": "%s.%s" % (x["tag"], m.strftime("%Y-%m")), "params": {**x["params"], "selected": str(back)}})
+                    m = (m + dt.timedelta(days=32)).replace(day=1)
+            extra.append(x)
+        params = {"key": pg["key"], "url": pg["url"], "outFile": out_file, "loginId": acc["loginId"],
+                  "start": a.start_d.isoformat(), "end": a.end_d.isoformat(), "maxPages": a.max_pages,
+                  "rangeReplay": bool(pg.get("rangeReplay")), "rangeTables": pg.get("rangeTables") or [],
+                  "rangeResume": range_resume(previous) if a.resume else {},
+                  "extra": extra, "inquiryList": bool(pg.get("inquiryList")), "budgetMs": 105000}
+        with open(os.path.join(HERE, "capture.js")) as fh:
+            src = fh.read().replace("__PARAMS__", json.dumps(params))
+        try:
+            proc = subprocess.run(["aside", "--host", "local", "--account", acc["asideAccount"], "repl", src], capture_output=True, text=True, timeout=170)
+            tail = (proc.stdout + proc.stderr)[-400:]
+        except subprocess.TimeoutExpired:
+            tail = "aside_timeout"
+        if not os.path.exists(out_file):
+            return {"key": pg["key"], "status": "aside_failed", "detail": REDACT.sub(r"\1***", tail), "records": []}
+        with open(out_file) as fh:
+            res = json.load(fh)
+        return res
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+
+def login(acc):
+    """Keychain password -> this process -> Aside stdin -> password box. Never printed or saved."""
+    svc, user = acc.get("keychainService"), acc.get("keychainAccount")
+    if not svc or not user:
+        return "no_keychain_config"
+    kc = subprocess.run(["security", "find-generic-password", "-s", svc, "-a", user, "-w"], capture_output=True, text=True)
+    if kc.returncode != 0:
+        return "keychain_item_missing"
+    pw = kc.stdout.rstrip("\n")
+    with open(os.path.join(HERE, "login.js")) as fh:
+        src = fh.read().replace("__PARAMS__", json.dumps({"email": user, "pw": pw, "loginId": acc["loginId"]}))
+    try:
+        command = "await eval(%s)\n" % json.dumps("(async () => {\n" + src + "\n})()")
+        proc = subprocess.run(["aside", "--host", "local", "--account", acc["asideAccount"], "repl"], input=command, capture_output=True, text=True, timeout=170)
+        text = (proc.stdout + proc.stderr).replace(pw, "***")
+    finally:
+        del src, command, pw
+    line = next((l for l in text.splitlines() if l.startswith("STATUS ")), "")
+    return line[7:] if line else "aside_failed: " + text.strip()[-200:]
+
+
+# -- post-processing -------------------------------------------------------------
+def jparse(text):
+    if text is None:
+        return None
+    try:
+        return json.loads(text)
+    except ValueError:
+        m = re.match(r"^[\w$.]+\(([\s\S]*)\)\s*;?\s*$", text.strip())
+        if m:
+            try:
+                return json.loads(m.group(1))
+            except ValueError:
+                return None
+    return None
+
+
+def object_arrays(o, path="$", depth=0):
+    """Yield (path, list_of_dicts) for every array of objects in o."""
+    if depth > 8:
+        return
+    if isinstance(o, list):
+        if o and all(isinstance(x, dict) for x in o):
+            yield path, o
+        for i, x in enumerate(o[:1]):
+            yield from object_arrays(x, path + "[0]", depth + 1)
+    elif isinstance(o, dict):
+        for k, v in o.items():
+            yield from object_arrays(v, path + "." + k, depth + 1)
+
+
+def flatten(row):
+    out = {}
+    for k, v in row.items():
+        out[k] = json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else v
+    return out
+
+
+def slug(s, n=60):
+    return re.sub(r"[^A-Za-z0-9._-]+", "_", s).strip("_")[:n] or "x"
+
+
+def write_page(res, out_dir):
+    """raw/<page>.jsonl = every record as captured. tables/<page>/<name>.csv = every array of
+    objects; arrays from the pages of one replay (same tag/table + path) go into one CSV."""
+    key = res.get("key") or "page"
+    files, endpoints, groups = [], {}, {}
+    raw_path = os.path.join(out_dir, "raw", key + ".jsonl")
+    os.makedirs(os.path.dirname(raw_path), exist_ok=True)
+    with open(raw_path, "w") as fh:
+        for r in res.get("records", []):
+            j = jparse(r.get("text"))
+            line = {k: r.get(k) for k in ("seq", "via", "method", "url", "reqContentType", "body", "status", "ct", "truncated", "replay", "error")}
+            if j is not None:
+                line["json"] = j
+            else:
+                line["text"] = r.get("text")
+            fh.write(REDACT_JSON.sub(r"\1***", REDACT.sub(r"\1***", json.dumps(line, ensure_ascii=False))) + "\n")
+            ep = (r.get("method") or "") + " " + (r.get("url") or "").split("?")[0]
+            endpoints[ep] = endpoints.get(ep, 0) + 1
+            if j is None:
+                continue
+            rp = r.get("replay") or {}
+            label = rp.get("tag") or rp.get("table")
+            if label and rp.get("kind") == "range":
+                label = "range-" + label
+            if not label:
+                m = re.search(r"[?&]iName=([^&]+)", r.get("url") or "") or re.search(r"(?:^|&)iName=([^&]+)", r.get("body") or "")
+                label = "%04d-%s" % (r.get("seq", 0), (m.group(1) if m else ep.split("/")[-1]))
+                if rp.get("kind") == "page":
+                    label = "page-" + label
+            for path, rows in object_arrays(j):
+                g = groups.setdefault((slug(label, 70), slug(path, 60)), [])
+                for row in rows:
+                    g.append({"_seq": r.get("seq"), "_page": rp.get("page", 1), **flatten(row)})
+    tdir = os.path.join(out_dir, "tables", key)
+    for (label, path), rows in groups.items():
+        os.makedirs(tdir, exist_ok=True)
+        cols = []
+        for row in rows:
+            for c in row:
+                if c not in cols:
+                    cols.append(c)
+        tp = os.path.join(tdir, "%s__%s.csv" % (label, path))
+        with open(tp, "w", newline="") as tf:
+            w = csv.DictWriter(tf, fieldnames=cols)
+            w.writeheader()
+            for row in rows:
+                w.writerow({c: (REDACT_JSON.sub(r"\1***", REDACT.sub(r"\1***", v)) if isinstance(v, str) else v) for c, v in row.items()})
+        files.append(tp)
+    files.append(raw_path)
+    summary = {"key": key, "url": res.get("url"), "finalUrl": res.get("finalUrl"), "status": res.get("status"),
+               "records": len(res.get("records", [])), "replays": sum(1 for r in res.get("records", []) if r.get("replay")),
+               "tables": len(groups), "endpoints": endpoints, "notes": res.get("notes", []) + ([res["detail"]] if res.get("detail") else [])}
+    return summary, files
+
+
+def scan(paths):
+    hits = []
+    for p in paths:
+        with open(p, errors="ignore") as fh:
+            t = fh.read()
+        hits += ["%s:%s" % (os.path.relpath(p), r.pattern[:10]) for r in SECRET_RES if r.search(t)]
+    return hits
+
+
+def main(argv=None):
+    a = parse_args(argv if argv is not None else sys.argv[1:])
+    pages = load_pages()
+    if a.list_pages:
+        for pg in pages:
+            print("%-28s %s%s" % (pg["key"], pg["url"], "  (ads range replay)" if pg.get("rangeReplay") else ""))
+        return 0
+    if not a.account:
+        raise SystemExit("--account is required")
+    acc = load_account(a.config, a.account)
+    if a.login:
+        st = login(acc)
+        print(json.dumps({"account": a.account, "login": st}, ensure_ascii=False))
+        return 0 if st in ("signed_in", "already_signed_in") else 1
+    want = None if a.pages == "all" else {k.strip() for k in a.pages.split(",") if k.strip()}
+    if want:
+        unknown = want - {p["key"] for p in pages}
+        if unknown:
+            raise SystemExit("unknown page keys: %s (see --list-pages)" % ", ".join(sorted(unknown)))
+        pages = [p for p in pages if p["key"] in want]
+    base = acc.get("outDir") or os.path.expanduser("~/30_Assets/%s/seller-report" % a.account)
+    out_dir = a.out or os.path.join(base, "sellercentral-raw-%s" % a.end_d.isoformat())
+    os.makedirs(out_dir, exist_ok=True)
+    manifest = {"account": a.account, "start": a.start_d.isoformat(), "end": a.end_d.isoformat(),
+                "generatedAt": dt.datetime.now().astimezone().isoformat(timespec="seconds"), "pages": []}
+    files, code = [], 0
+    for pg in pages:
+        previous = []
+        prior_path = os.path.join(out_dir, "raw", pg["key"] + ".jsonl")
+        if a.resume and os.path.isfile(prior_path):
+            with open(prior_path) as fh:
+                previous = [json.loads(line) for line in fh if line.strip()]
+        res = run_capture(pg, acc, a, previous)
+        if previous:
+            for record in previous:
+                if "json" in record:
+                    record["text"] = json.dumps(record.pop("json"), ensure_ascii=False)
+            res["records"] = previous + res.get("records", [])
+            for index, record in enumerate(res["records"]):
+                record["seq"] = index
+        st = res.get("status")
+        summary, fs = write_page(res, out_dir)
+        manifest["pages"].append(summary)
+        files += fs
+        print("%-28s %-15s records=%s replays=%s tables=%s" % (pg["key"], st, summary["records"], summary["replays"], summary["tables"]), flush=True)
+        if st == "session_expired":
+            code = EXIT_SESSION
+            break
+        if st == "wrong_account":
+            code = EXIT_ACCOUNT
+            break
+    mp = os.path.join(out_dir, "manifest.json")
+    if os.path.exists(mp):  # rerun of some pages into an existing folder: keep the other pages' entries
+        try:
+            with open(mp) as fh:
+                prev = json.load(fh)
+            done = {p["key"] for p in manifest["pages"]}
+            manifest["pages"] = [p for p in prev.get("pages", []) if p.get("key") not in done] + manifest["pages"]
+        except (OSError, ValueError):
+            pass
+    with open(mp, "w") as fh:
+        json.dump(manifest, fh, ensure_ascii=False, indent=1)
+    files.append(mp)
+    hits = scan(files)
+    if hits:
+        for f in files:
+            os.remove(f)
+        print("ABORT: token-like strings found, outputs removed: %s" % ", ".join(hits[:10]), file=sys.stderr)
+        return EXIT_SECRET
+    print(json.dumps({"out": out_dir, "pages": len(manifest["pages"]),
+                      "ok": sum(1 for p in manifest["pages"] if p["status"] == "ok"),
+                      "records": sum(p["records"] for p in manifest["pages"]),
+                      "tables": sum(p["tables"] for p in manifest["pages"])}, ensure_ascii=False))
+    if os.path.exists(os.path.join(out_dir, "raw", "inquiries.jsonl")):
+        import inquiry_attribution
+        inquiry_attribution.main([out_dir])
+    if code == EXIT_SESSION:
+        print("session expired -> run with --login, then rerun", file=sys.stderr)
+    elif code == EXIT_ACCOUNT:
+        print("Aside is signed in to a different seller than loginId -> sign out in Aside, then --login", file=sys.stderr)
+    return code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/lib/cli.mjs b/lib/cli.mjs
new file mode 100644
index 0000000..94169b5
--- /dev/null
+++ b/lib/cli.mjs
@@ -0,0 +1,156 @@
+// Command registry and runner. Read commands = (seller-center pages to dump) + (report over the dump).
+// With --from <dump folder> nothing is fetched; otherwise the engine dumps those pages for the
+// requested range (split into windows of at most MAX_WINDOW_DAYS) and the report merges the windows.
+import { spawnSync } from "node:child_process";
+import { readFileSync, existsSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { resolveRange, splitRange } from "./dates.mjs";
+
+const ROOT = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+export const ENGINE = path.join(ROOT, "engine");
+export const DEFAULT_CONFIG = path.join(homedir(), ".aliops-ops/seller-report/accounts.json");
+
+const INQ = ["inquiries"];
+const ADS = ["ads-report", "ads-campaigns"];
+const ANALYZE = ["inquiries", "ads-report", "ads-campaigns", "analytics-product", "analytics-keyword"];
+
+export const READ_COMMANDS = {
+  "inquiry list": { pages: INQ, report: "inquiry-list", help: "문의 목록(허용 필드만) [--unread] [--type product|company|tm] [--country XX] [--status N] [--limit N]" },
+  "inquiry stats": { pages: INQ, report: "inquiry-stats", help: "유형·진입점·기기·국가·답장 상태·일자별 문의 수" },
+  "inquiry by-product": { pages: ["inquiries", "ads-report", "analytics-product"], report: "inquiry-by-product", help: "상품ID → 문의 (TM 은 'TM 유입')" },
+  "inquiry fields": { pages: INQ, report: "inquiry-fields", help: "문의 목록 응답의 키 이름(값 없음): 바이어 레벨 필드 찾기" },
+  "ads report": { pages: ["ads-report"], report: "ads-report", help: "광고 리포트 표: 상품×일, 캠페인×일, 계정×일" },
+  "ads products": { pages: ADS, report: "ads-products", help: "상품별 광고비(실측/추정)·노출·클릭·CPC·전환율·문의 1건 비용" },
+  "ads analyze": { pages: ANALYZE, report: "ads-analyze", help: "광고 분석 CSV 4개 + summary.md (스킬 alibaba-ad-analysis 가 부름)" },
+  keywords: { pages: ["ads-report", "analytics-keyword", "analytics-product"], report: "keywords", help: "키워드·노출·클릭·입찰가/CPC" },
+  bids: { pages: ADS, report: "bids", help: "캠페인 입찰가(목표 전환단가)·키워드 입찰가 필드" },
+  coverage: { pages: [...ANALYZE, "showcase"], report: "coverage", help: "항목별 추출됨(행 수·출처)/없음(사유) 표" },
+};
+
+const FLAGS_WITH_VALUE = new Set(["account", "start", "end", "days", "out", "from", "pages", "config", "type", "country", "status", "limit", "max-pages", "dump-dir"]);
+
+export function parseArgs(argv) {
+  const pos = [], opt = { from: [] };
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i];
+    if (!a.startsWith("--")) { pos.push(a); continue; }
+    const [k, inline] = a.slice(2).split(/=(.*)/s, 2);
+    if (FLAGS_WITH_VALUE.has(k)) {
+      const v = inline ?? argv[++i];
+      if (v === undefined) throw new Error(`--${k} 값이 없다`);
+      if (k === "from") opt.from.push(v); else opt[k] = v;
+    } else opt[k] = true;
+  }
+  return { pos, opt };
+}
+
+export function loadAccount(configPath, name) {
+  if (!name) throw new Error("--account <계정키> 가 필요하다 (accounts.json 의 키)");
+  if (!existsSync(configPath)) throw new Error(`계정 설정 없음: ${configPath} (README 의 accounts.json 절)`);
+  const all = JSON.parse(readFileSync(configPath, "utf8"));
+  const acc = all[name];
+  if (!acc) throw new Error(`계정 ${name} 이 ${configPath} 에 없다 (있는 키: ${Object.keys(all).sort().join(", ")})`);
+  if (typeof acc.loginId !== "string" || !acc.loginId.trim()) throw new Error("loginId 가 비어 있다");
+  const asideAccount = acc.asideAccount ?? "u0";
+  if (!/^u\d+$/.test(asideAccount)) throw new Error("asideAccount 는 u0, u1 … 형식");
+  return { ...acc, asideAccount, name };
+}
+
+const python = (args, run) => run("python3", args, { stdio: "inherit" });
+
+export function defaultRun(cmd, args, opts) {
+  const r = spawnSync(cmd, args, opts);
+  if (r.error) throw r.error;
+  return r.status ?? 1;
+}
+
+// Live dump of `pages` over the range, one engine run per window. -> list of dump folders.
+export function dumpWindows({ account, configPath, pages, range, root, opt, run }) {
+  const windows = splitRange(range.start, range.end);
+  const dirs = [];
+  for (const w of windows) {
+    const dir = windows.length === 1 ? root : path.join(root, `w-${w.start}_${w.end}`);
+    const args = [path.join(ENGINE, "seller_central_raw.py"), "--account", account.name, "--config", configPath,
+      "--start", w.start, "--end", w.end, "--out", dir];
+    if (pages) args.push("--pages", pages.join(","));
+    if (opt.resume) args.push("--resume");
+    if (opt["max-pages"]) args.push("--max-pages", String(opt["max-pages"]));
+    const code = python(args, run);
+    if (code !== 0) return { dirs, code, failedWindow: w };
+    dirs.push(dir);
+  }
+  return { dirs, code: 0 };
+}
+
+function dumpRoot(account, range, opt) {
+  if (opt["dump-dir"]) return opt["dump-dir"];
+  const base = account.outDir || path.join(homedir(), "30_Assets", account.name, "seller-report");
+  return path.join(base, `sellercentral-raw-${range.start}_${range.end}`);
+}
+
+export function main(argv, { run = defaultRun, log = console.log, err = console.error } = {}) {
+  const { pos, opt } = parseArgs(argv);
+  const configPath = opt.config || DEFAULT_CONFIG;
+  const name2 = pos.slice(0, 2).join(" ");
+  const cmd = READ_COMMANDS[name2] ? name2 : READ_COMMANDS[pos[0]] ? pos[0] : pos[0];
+
+  if (!cmd || opt.help || cmd === "help") { log(usage()); return 0; }
+  if (cmd === "pages") return python([path.join(ENGINE, "seller_central_raw.py"), "--list-pages"], run);
+  if (cmd === "login") {
+    loadAccount(configPath, opt.account);
+    return python([path.join(ENGINE, "seller_central_raw.py"), "--account", opt.account, "--config", configPath, "--login"], run);
+  }
+  if (cmd === "dump") {
+    const account = loadAccount(configPath, opt.account);
+    const range = resolveRange(opt);
+    range.warnings.forEach((w) => err("주의: " + w));
+    const pages = opt.pages && opt.pages !== "all" ? opt.pages.split(",").map((s) => s.trim()).filter(Boolean) : null;
+    const res = dumpWindows({ account, configPath, pages, range, root: opt.out || dumpRoot(account, range, opt), opt, run });
+    log(JSON.stringify({ query_start: range.start, query_end: range.end, windows: res.dirs }));
+    return res.code;
+  }
+  const spec = READ_COMMANDS[cmd];
+  if (!spec) { err(`모르는 명령: ${pos.join(" ")}\n` + usage()); return 64; }
+
+  let dirs = opt.from, range = null;
+  if (opt.start || opt.end || opt.days || opt.all) {
+    range = resolveRange(opt);
+    range.warnings.forEach((w) => err("주의: " + w));
+  }
+  if (!dirs.length) {
+    const account = loadAccount(configPath, opt.account);
+    if (!range) range = resolveRange(opt); // throws the usage message for a missing period
+    const res = dumpWindows({ account, configPath, pages: spec.pages, range, root: dumpRoot(account, range, opt), opt, run });
+    if (res.code !== 0) { err(`덤프 실패(종료 코드 ${res.code}, 창 ${res.failedWindow.start}~${res.failedWindow.end})`); return res.code; }
+    dirs = res.dirs;
+  } else {
+    for (const d of dirs) if (!existsSync(path.join(d, "raw")) || !statSync(path.join(d, "raw")).isDirectory()) throw new Error(`덤프 폴더가 아님(raw/ 없음): ${d}`);
+  }
+  const args = [path.join(ENGINE, "report.py"), spec.report, ...dirs.flatMap((d) => ["--from", d])];
+  if (range) args.push("--start", range.start, "--end", range.end);
+  args.push("--format", opt.json ? "json" : opt.csv ? "csv" : "table");
+  let out = opt.out;
+  if (!out && spec.report === "ads-analyze") out = path.join(dirs[0], "analysis", "ad_analysis");
+  if (out) args.push("--out", out);
+  for (const k of ["limit", "type", "country", "status"]) if (opt[k] != null) args.push("--" + k, String(opt[k]));
+  if (opt.unread) args.push("--unread");
+  return python(args, run);
+}
+
+export function usage() {
+  const rows = Object.entries(READ_COMMANDS).map(([k, v]) => `  ${k.padEnd(20)} ${v.help}`);
+  return [
+    "alibaba-seller <명령> --account <계정키> --start YYYY-MM-DD --end YYYY-MM-DD [--json|--csv] [--out DIR]",
+    "                       (기간 대신 --days N | --all, 덤프가 있으면 --account 대신 --from <덤프 폴더> 여러 번)",
+    "",
+    "읽기 명령:",
+    ...rows,
+    "",
+    "덤프·계정:",
+    "  dump                 셀러센터 페이지 raw 덤프 [--pages a,b] [--resume] [--max-pages N]",
+    "  pages                덤프 가능한 페이지 키 목록",
+    "  login                키체인 비밀번호로 Aside 로그인(비밀번호는 stdin 으로만)",
+  ].join("\n");
+}
diff --git a/lib/dates.mjs b/lib/dates.mjs
new file mode 100644
index 0000000..46c97ca
--- /dev/null
+++ b/lib/dates.mjs
@@ -0,0 +1,63 @@
+// Date ranges for every period command. --start/--end are the query; --days/--all are presets
+// turned into start/end here. Dates are calendar dates (YYYY-MM-DD) as the seller center takes them.
+
+export const MAX_WINDOW_DAYS = 91; // longest ads report window seen answered in one call (2026-06-28..2026-09-26)
+export const ALL_DAYS = 181; // offline_effect_report filter_timer range seen: 2026-05-19..2026-11-15
+
+const DAY = 864e5;
+
+export function parseDate(text, flag = "date") {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(text ?? ""));
+  const d = m && new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
+  if (!d || d.getUTCMonth() !== +m[2] - 1 || d.getUTCDate() !== +m[3]) throw new Error(`${flag}: YYYY-MM-DD 형식이 아님: ${text}`);
+  return d;
+}
+
+export const iso = (d) => d.toISOString().slice(0, 10);
+const addDays = (d, n) => new Date(d.getTime() + n * DAY);
+
+export function todayLocal(now = new Date()) {
+  return new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
+}
+
+// -> {start, end, warnings[]}; throws on bad input.
+export function resolveRange({ start, end, days, all } = {}, today = todayLocal()) {
+  const warnings = [];
+  const presets = [start || end ? "start/end" : null, days != null ? "days" : null, all ? "all" : null].filter(Boolean);
+  if (presets.length > 1) throw new Error("--start/--end, --days, --all 중 하나만 쓴다");
+  let s, e;
+  if (days != null) {
+    const n = Number(days);
+    if (!Number.isInteger(n) || n < 1) throw new Error(`--days: 1 이상 정수가 아님: ${days}`);
+    e = today;
+    s = addDays(today, -(n - 1));
+  } else if (all) {
+    e = today;
+    s = addDays(today, -(ALL_DAYS - 1));
+    warnings.push(`--all = 최근 ${ALL_DAYS}일(셀러센터 효과 리포트 조회 가능 범위)`);
+  } else {
+    if (!start || !end) throw new Error("기간: --start YYYY-MM-DD --end YYYY-MM-DD (또는 --days N, --all)");
+    s = parseDate(start, "--start");
+    e = parseDate(end, "--end");
+  }
+  if (e > today) {
+    warnings.push(`--end ${iso(e)} 은 미래라 오늘 ${iso(today)} 로 자름`);
+    e = today;
+  }
+  if (s > e) throw new Error(`--start ${iso(s)} 가 --end ${iso(e)} 보다 늦다`);
+  return { start: iso(s), end: iso(e), warnings };
+}
+
+// Split start..end (inclusive) into consecutive windows of at most maxDays.
+export function splitRange(start, end, maxDays = MAX_WINDOW_DAYS) {
+  const out = [];
+  let s = parseDate(start, "start");
+  const e = parseDate(end, "end");
+  while (s <= e) {
+    const w = addDays(s, maxDays - 1);
+    const we = w < e ? w : e;
+    out.push({ start: iso(s), end: iso(we) });
+    s = addDays(we, 1);
+  }
+  return out;
+}
