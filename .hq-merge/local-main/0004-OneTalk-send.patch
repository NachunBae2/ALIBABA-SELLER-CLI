env 없는 --send 가 엔진·Aside 로 문의 목록을 먼저 조회하던 순서를 고친다.
이제 run·spawn 0회, 종료 77 로 거부한다(테스트로 고정). 안 읽은 대화 관문은 조회 뒤 그대로.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F23MULdm3brtzhWYCu934T
---
 lib/cli.mjs           |  3 ++-
 lib/onetalk.mjs       | 10 ++++++++--
 test/onetalk.test.mjs | 13 +++++++++++++
 3 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/lib/cli.mjs b/lib/cli.mjs
index 6162346..f6a50e8 100644
--- a/lib/cli.mjs
+++ b/lib/cli.mjs
@@ -7,7 +7,7 @@ import { homedir } from "node:os";
 import path from "node:path";
 import { fileURLToPath } from "node:url";
 import { resolveRange, splitRange } from "./dates.mjs";
-import { ONETALK, onetalkMain } from "./onetalk.mjs";
+import { ONETALK, onetalkMain, sendGate } from "./onetalk.mjs";
 
 const ROOT = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
 export const ENGINE = path.join(ROOT, "engine");
@@ -118,6 +118,7 @@ export function main(argv, deps = {}) {
     return res.code;
   }
   if (ONETALK[cmd]) {
+    sendGate(ONETALK[cmd], opt, deps.env || process.env);
     const account = loadAccount(configPath, opt.account);
     return onetalkMain(ONETALK[cmd], opt, { account, configPath, enginePath: path.join(ENGINE, "seller_central_raw.py"), run, log, ...(deps.env ? { env: deps.env } : {}), ...(deps.spawn ? { spawn: deps.spawn } : {}) });
   }
diff --git a/lib/onetalk.mjs b/lib/onetalk.mjs
index b8e5071..c9257fa 100644
--- a/lib/onetalk.mjs
+++ b/lib/onetalk.mjs
@@ -31,10 +31,15 @@ export class Refused extends Error {
   constructor(message) { super(message); this.code = EXIT_REFUSED; }
 }
 
-// -> "dry-run" | "open" | "send"; throws Refused.
-export function gate(spec, opt, env, conversation) {
+// Checks that need no lookup: run before any engine or Aside call.
+export function sendGate(spec, opt, env) {
   if (opt.send && !spec.write) throw new Refused("--send 는 보내는 명령에만 쓴다");
   if (opt.send && env[SEND_ENV] !== SEND_ENV_VALUE) throw new Refused(`실발송 거부: --send 와 환경변수 ${SEND_ENV}=${SEND_ENV_VALUE} 가 둘 다 있어야 한다`);
+}
+
+// -> "dry-run" | "open" | "send"; throws Refused.
+export function gate(spec, opt, env, conversation) {
+  sendGate(spec, opt, env);
   if (conversation && conversation.unread && !opt["allow-mark-read"]) throw new Refused("안 읽은 대화라 열면 읽음 처리된다: --allow-mark-read 없이는 거부");
   if (opt.send) return "send";
   if (opt["allow-open"] && (spec.opens || spec.write)) return "open";
@@ -106,6 +111,7 @@ export function lookupConversation({ opt, account, configPath, enginePath, run }
 
 export function onetalkMain(spec, opt, { account, configPath, enginePath, run, env = process.env, spawn, log = console.log }) {
   validate(spec, opt);
+  sendGate(spec, opt, env);
   let conversation = null;
   if (spec.conversation) {
     conversation = lookupConversation({ opt, account, configPath, enginePath, run });
diff --git a/test/onetalk.test.mjs b/test/onetalk.test.mjs
index 8751850..a7ad977 100644
--- a/test/onetalk.test.mjs
+++ b/test/onetalk.test.mjs
@@ -149,3 +149,16 @@ test("CLI: --send without env is refused before Aside is called; dry-run calls A
   assert.equal(main(["reply", "--account", "fixture", "--config", cfg, "--from", d, "--inquiry-id", "6", "--text", "hi"], { spawn, env: {}, log() {}, err() {} }), 0);
   assert.deepEqual(modes, ["dry-run"]);
 });
+
+test("CLI: --send without the env is refused before the inquiry lookup (no engine, no Aside) with code 77", () => {
+  const dir = mkdtempSync(path.join(tmpdir(), "asc-cfg-"));
+  const cfg = path.join(dir, "accounts.json");
+  writeFileSync(cfg, JSON.stringify({ fixture: { loginId: "fixture-login" } }));
+  let runs = 0, spawns = 0;
+  const deps = { run: () => { runs++; return 0; }, spawn: () => { spawns++; return { stdout: "" }; }, env: {}, log() {}, err() {} };
+  for (const argv of [["reply", "--text", "x"], ["send-card"], ["tag", "add", "--tag", "VIP"]]) {
+    assert.throws(() => main([...argv, "--account", "fixture", "--config", cfg, "--inquiry-id", "123", "--send"], deps), (e) => e instanceof Refused && e.code === 77);
+  }
+  assert.equal(runs, 0);
+  assert.equal(spawns, 0);
+});
